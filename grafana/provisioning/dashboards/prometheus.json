          "query": "from(bucket: \"network-metrics\")\n  |> range(start: -30m)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"system_metrics\")\n  |> last()\n  |> keep(columns: [\"_time\"])\n  |> group()\n  |> max(column: \"_time\")\n  |> map(fn: (r) => ({ r with _value: float(v: uint(v: now()) - uint(v: r._time)) / 1000000000.0 }))",
